POSTGRES_DB=beatgame
POSTGRES_USER=beatgame
POSTGRES_PASSWORD=secret

DEEZER_API_BASE_URL=https://api.deezer.com
ITUNES_API_BASE_URL=https://itunes.apple.com

# Local: http://localhost (for same-network access use http://<your-ip>)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Admin endpoint token — leave blank to disable POST /api/admin/tracks/populate
ADMIN_TOKEN=

# HMAC signing key for guest session JWTs — required, generate with: openssl rand -base64 32
JWT_SECRET=

# Shared password for the frontend gate — leave blank to disable the gate
VITE_ACCESS_PASSWORD=

# Self-hosted Grafana admin login (observability stack) - must be set
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
